# Waitlist -> Airtable
#
# Leave these unset for local dev: signups fall back to data/waitlist.json.
# Set both required vars to store signups in Airtable instead. Copy this file to
# .env.local and fill in real values (and add the same vars in Vercel for prod).
#
# Setup:
#   1. Create a base at https://airtable.com with a table named "Waitlist".
#   2. Add these fields, with these exact names:
#        Organization  - Single line text
#        Email         - Single line text
#        Joined At     - Single line text (or Date)
#   3. Create a personal access token at https://airtable.com/create/tokens
#      with scopes  data.records:read  +  data.records:write, and add access to
#      the base from step 1.
#   4. Find the base id (starts with "app...") at https://airtable.com/api

AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Optional. Table name or id. Defaults to "Waitlist".
AIRTABLE_TABLE=Waitlist
